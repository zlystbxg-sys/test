          <Variable name="Start_Counter"><Type><TypeName>CTU</TypeName></Type></Variable>
          <Variable name="Fault_Counter"><Type><TypeName>CTU</TypeName></Type></Variable>
          
          <!-- 时间常数 -->
          <Variable name="START_DELAY_TIME"><Type><TypeName>TIME</TypeName></Type></Variable>
          <Variable name="STOP_DELAY_TIME"><Type><TypeName>TIME</TypeName></Type></Variable>
          <Variable name="FAULT_RESET_TIME"><Type><TypeName>TIME</TypeName></Type></Variable>
          <Variable name="WATCHDOG_TIME"><Type><TypeName>TIME</TypeName></Type></Variable>
          <Variable name="BLINK_TIME"><Type><TypeName>TIME</TypeName></Type></Variable>
        </Vars>

        <MainBody>
          <BodyContent xsi:type="ST">
            <ST>(*
================================================================================
PLC程序模板 - 可根据具体项目需求修改
================================================================================
*)

(* ========== 参数初始化 ========== *)
IF START_DELAY_TIME = T#0MS THEN
    START_DELAY_TIME := T#500MS;
END_IF;

IF STOP_DELAY_TIME = T#0MS THEN
    STOP_DELAY_TIME := T#200MS;
END_IF;

IF FAULT_RESET_TIME = T#0MS THEN
    FAULT_RESET_TIME := T#3S;
END_IF;

IF WATCHDOG_TIME = T#0MS THEN
    WATCHDOG_TIME := T#5S;
END_IF;

IF BLINK_TIME = T#0MS THEN
    BLINK_TIME := T#500MS;
END_IF;

(* ========== 保护条件检查 ========== *)
Protection_OK := gEmergency_Stop AND gOverload_Relay AND gThermal_Switch;

(* ========== 故障检测 ========== *)
Emergency_Fault := NOT gEmergency_Stop;
Overload_Fault := NOT gOverload_Relay;
Thermal_Fault := NOT gThermal_Switch;
Fault_Status := Emergency_Fault OR Overload_Fault OR Thermal_Fault OR Timeout_Fault;

(* ========== 启动/停止条件 ========== *)
Start_Condition := gStart_Button AND Protection_OK AND NOT Fault_Status AND System_Enable;
Stop_Condition := gStop_Button OR Fault_Status;

(* ========== 定时器处理 ========== *)
Start_Delay_Timer(
    IN := Start_Condition AND NOT Run_Command,
    PT := START_DELAY_TIME
);

Fault_Reset_Timer(
    IN := Protection_OK AND Fault_Status,
    PT := FAULT_RESET_TIME
);

Blink_Timer(
    IN := TRUE,
    PT := BLINK_TIME
);

(* ========== 主控制逻辑 ========== *)
IF Start_Delay_Timer.Q THEN
    Run_Command := TRUE;
ELSIF Stop_Condition THEN
    Run_Command := FALSE;
END_IF;

(* ========== 状态机控制 ========== *)
CASE System_State OF
    0: (* 停止状态 *)
        IF Start_Delay_Timer.Q THEN
            System_State := 2;
        END_IF;
        
    2: (* 运行状态 *)
        IF Stop_Condition THEN
            System_State := 0;
        END_IF;
        
    99: (* 故障状态 *)
        IF Fault_Reset_Timer.Q THEN
            System_State := 0;
        END_IF;
        
    ELSE
        System_State := 0;
END_CASE;

(* ========== 输出控制 ========== *)
gMain_Contactor := Run_Command AND Protection_OK;
gReady_Indicator := (System_State = 0) AND Protection_OK AND NOT Fault_Status;
gRun_Indicator := (System_State = 2);
gFault_Indicator := Fault_Status AND Blink_Timer.Q;
</ST>
          </BodyContent>
        </MainBody>
      </Program>

    </GlobalNamespace>
  </Types>

