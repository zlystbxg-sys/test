        <Variable name="gMotor_Contactor"><Type><TypeName>BOOL</TypeName></Type><Address address="Y0" /></Variable>
        <Variable name="gRun_Indicator"><Type><TypeName>BOOL</TypeName></Type><Address address="Y1" /></Variable>
        <Variable name="gFault_Indicator"><Type><TypeName>BOOL</TypeName></Type><Address address="Y2" /></Variable>
